# Copy to .env for local development (`npx shopify hydrogen env pull` fills
# most of these from the linked Oxygen environment). Never commit real values.

# --- Shopify / Hydrogen (read by createHydrogenContext) ---
# Signs the session cookie; any long random string locally
SESSION_SECRET=
# Storefront API public access token
PUBLIC_STOREFRONT_API_TOKEN=
# Storefront API private (server-side) token
PRIVATE_STOREFRONT_API_TOKEN=
# The shop's myshopify.com domain, e.g. example.myshopify.com
PUBLIC_STORE_DOMAIN=
# Hydrogen storefront id (analytics)
PUBLIC_STOREFRONT_ID=
# Customer Account API client id
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
# Shopify shop id (Customer Account API)
SHOP_ID=
# Domain of the Online Store / checkout (kosR app proxy and Shopify checkout live here)
PUBLIC_CHECKOUT_DOMAIN=
# Storefront API version used by the password-reset route (defaults to 2025-01)
STOREFRONT_API_VERSION=

# --- E-mail (Resend): newsletter and contact form ---
# Resend API key
RESEND_API_KEY=
# Sender address, on a domain verified in Resend
FROM_EMAIL=
# Inbox that receives contact-form messages and new-subscriber notices
CONTACT_EMAIL=
# Optional Discord webhook notified on each contact-form message
DISCORD_WEBHOOK_URL=

# --- Shop presentation ---
# Store name shown in the UI
STORE_NAME=
# Social profile links shown in the footer and contact page
INSTAGRAM_URL=
FACEBOOK_URL=
TIKTOK_URL=
YOUTUBE_URL=

# --- Admin API custom app (client credentials) ---
# Read access to discounts and products; drives the campaign banners. Optional.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Legacy names of the same credentials; also used by scripts/seed-content.cjs
WRITE_INVENTORY_CLIENT_ID=
WRITE_INVENTORY_SECRET=
